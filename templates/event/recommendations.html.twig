{% extends 'base.html.twig' %}
{% block title %}Event Recommendations{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-stars me-2"></i>Recommended Events</h5>
        <div class="text-muted small">You only need two fields to get event suggestions.</div>
    </div>
    <a href="{{ path('event_index') }}" class="btn btn-outline-success btn-sm">Back to Events</a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <div class="fw-semibold mb-2">How Event AI Recommendation works</div>
        <div class="small text-muted mb-2">
            <strong>Your location:</strong> type a city or area like Tunis or Sfax. The system compares that text with event locations and gives higher ranking to events that match or look close to that location.
        </div>
        <div class="small text-muted">
            <strong>Tell us what you want:</strong> type naturally, for example "I want something online", "I want a farming workshop near Tunis", or "I want beginner training about irrigation". You do not need to type the exact event words. The system reads the sentence more like a chatbot request and tries to match related meaning.
        </div>
    </div>
</div>

<form method="get" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Your location</label>
            <input type="text" name="location" value="{{ location }}" class="form-control" placeholder="Tunis, Sfax, Ariana, city or area">
        </div>
        <div class="col-md-5">
            <label class="form-label">Tell us what you want</label>
            <input type="text" name="need" value="{{ need }}" class="form-control" placeholder="I want something online or a farming workshop near Tunis">
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-success">Get Recommendations</button>
        </div>
    </div>
</form>

{% if recommendations is empty %}
    <div class="text-center text-muted py-5">
        <i class="bi bi-search" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-2">No matching recommendations right now.</p>
    </div>
{% else %}
    <div class="row g-3">
        {% for item in recommendations %}
            {% set event = item.event %}
            {% set fillRatio = event.capacity and event.capacity > 0 ? (event.confirmedCount / event.capacity) : null %}
            {% set availabilityLabel = fillRatio is null ? 'Available' : (fillRatio < 0.5 ? 'Available' : (fillRatio < 0.85 ? 'Half full' : 'Almost full')) %}
            {% set availabilityColor = fillRatio is null or fillRatio < 0.5 ? '#198754' : (fillRatio < 0.85 ? '#d97706' : '#c0392b') %}
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold mb-0 me-2">{{ event.title }}</h6>
                            <span class="badge bg-success-subtle text-success border">Score {{ item.score }}</span>
                        </div>
                        <div class="small mb-2" style="color: {{ availabilityColor }}">
                            <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ availabilityColor }};margin-right:6px"></span>{{ availabilityLabel }}
                        </div>
                        {% if event.category %}
                            <div class="mb-2"><span class="badge bg-light text-dark border">{{ event.category }}</span></div>
                        {% endif %}
                        <p class="text-muted small mb-2">{{ event.description|slice(0, 120) }}{% if event.description|length > 120 %}...{% endif %}</p>
                        <div class="small text-muted mb-3">
                            <div><i class="bi bi-calendar-event me-1"></i>{{ event.eventDate ? event.eventDate|date('d M Y, H:i') : 'TBD' }}</div>
                            <div><i class="bi bi-geo-alt me-1"></i>{{ event.location }}</div>
                        </div>
                        {% if item.reasons is not empty %}
                            <div class="small">
                                {% for reason in item.reasons %}
                                    <div class="mb-1"><i class="bi bi-check-circle text-success me-1"></i>{{ reason }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 pb-3">
                        <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-success btn-sm w-100">View Event</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
