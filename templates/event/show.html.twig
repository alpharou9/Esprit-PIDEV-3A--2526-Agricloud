{% extends 'base.html.twig' %}
{% block title %}{{ event.title }} - AgriCloud{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .event-chat-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbf4 100%);
    }
    .event-chat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }
    .event-chat-avatar {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #77b81e 0%, #4f8d14 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        box-shadow: 0 10px 20px rgba(119,184,30,.18);
    }
    .event-chat-subtitle {
        color: #6b7e52;
        font-size: .78rem;
        margin-top: 2px;
    }
    .event-chat-window {
        background: #f5f8ef;
        border: 1px solid #e3ebd5;
        border-radius: 18px;
        padding: 14px;
        min-height: 150px;
    }
    .event-chat-bubble {
        border-radius: 16px;
        padding: 10px 14px;
        font-size: .88rem;
        line-height: 1.55;
        max-width: 100%;
    }
    .event-chat-bubble.bot {
        background: #ffffff;
        border: 1px solid #e3ebd5;
        color: #314a13;
    }
    .event-chat-bubble.user {
        background: #77b81e;
        color: #fff;
        margin-left: auto;
    }
    .event-chat-label {
        display: block;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        opacity: .8;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .event-chat-typing {
        display: inline-flex;
        gap: 4px;
        align-items: center;
    }
    .event-chat-typing span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #7e8d68;
        animation: eventChatPulse 1.2s infinite ease-in-out;
    }
    .event-chat-typing span:nth-child(2) { animation-delay: .15s; }
    .event-chat-typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes eventChatPulse {
        0%, 80%, 100% { transform: scale(.85); opacity: .35; }
        40% { transform: scale(1); opacity: 1; }
    }
    .event-chat-input {
        border-radius: 16px;
        border: 1px solid #dbe7c6;
        background: #fff;
        resize: none;
        padding: 12px 14px;
        font-size: .88rem;
        min-height: 94px;
    }
    .event-chat-input:focus {
        border-color: #77b81e;
        box-shadow: 0 0 0 3px rgba(119,184,30,.14);
        outline: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="d-flex align-items-center gap-2 mb-4">
    <a href="{{ path('event_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">{{ event.title }}</h5>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        {% if event.image %}
            <img src="{{ asset('uploads/events/' ~ event.image) }}" class="w-100 rounded-4 mb-4" style="max-height:380px;object-fit:cover" alt="{{ event.title }}">
        {% else %}
            <div class="rounded-4 d-flex align-items-center justify-content-center mb-4" style="height:260px;background:linear-gradient(135deg,#d1e7dd,#a3cfbb);font-size:5rem;color:#198754">
                <i class="bi bi-calendar-event"></i>
            </div>
        {% endif %}

        <div class="d-flex gap-2 flex-wrap mb-3">
            {% set sc = {upcoming:'success',ongoing:'primary',completed:'secondary',cancelled:'danger'} %}
            {% set fillRatio = event.capacity and event.capacity > 0 ? (event.confirmedCount / event.capacity) : null %}
            {% set availabilityLabel = fillRatio is null ? 'Available' : (fillRatio < 0.5 ? 'Available' : (fillRatio < 0.85 ? 'Half full' : 'Almost full')) %}
            {% set availabilityColor = fillRatio is null or fillRatio < 0.5 ? '#198754' : (fillRatio < 0.85 ? '#d97706' : '#c0392b') %}
            <span class="badge bg-{{ sc[event.status] ?? 'secondary' }}">{{ event.status|capitalize }}</span>
            <span class="badge border bg-white" style="color: {{ availabilityColor }}">
                <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ availabilityColor }};margin-right:6px"></span>{{ availabilityLabel }}
            </span>
            {% if event.category %}<span class="badge bg-light text-dark border">{{ event.category }}</span>{% endif %}
            <span class="text-muted small"><i class="bi bi-people me-1"></i>{{ event.confirmedCount }} registered{% if event.capacity %} / {{ event.capacity }} capacity{% endif %}</span>
        </div>

        <div class="mb-4" style="line-height:1.8;white-space:pre-wrap">{{ event.description }}</div>

        {% if event.user == app.user or is_granted('ROLE_ADMIN') %}
        <div class="d-flex gap-2 mb-4">
            <a href="{{ path('event_edit', {id: event.id}) }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a href="{{ path('event_participants', {id: event.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-people me-1"></i>Participants</a>
            <form method="post" action="{{ path('event_delete', {id: event.id}) }}" onsubmit="return confirm('Delete this event?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        </div>
        {% endif %}

        {% if event.user != app.user %}
            {% if myParticipation and myParticipation.status != 'cancelled' %}
                <div class="alert alert-success d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-check-circle me-1"></i>You are registered - <strong>{{ myParticipation.status|capitalize }}</strong></span>
                    {% if myParticipation.status != 'attended' %}
                    <form method="post" action="{{ path('event_cancel_registration', {id: myParticipation.id}) }}" onsubmit="return confirm('Cancel your registration?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_participation_' ~ myParticipation.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Cancel Registration</button>
                    </form>
                    {% endif %}
                </div>
            {% elseif event.isRegistrationOpen and not event.isFull %}
                <form method="post" action="{{ path('event_register', {id: event.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('register_event_' ~ event.id) }}">
                    <button class="btn btn-success px-5">
                        <i class="bi bi-ticket-perforated me-1"></i>Register Now
                    </button>
                </form>
            {% elseif event.isFull %}
                <div class="alert alert-warning small"><i class="bi bi-exclamation-triangle me-1"></i>This event is full.</div>
            {% else %}
                <div class="alert alert-secondary small"><i class="bi bi-lock me-1"></i>Registration is closed.</div>
            {% endif %}
        {% endif %}
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-info-circle me-1"></i>Event Details</h6>
            <ul class="list-unstyled small text-muted mb-0">
                <li class="mb-2"><i class="bi bi-calendar-event me-2 text-success"></i><strong>Start:</strong> {{ event.eventDate ? event.eventDate|date('d M Y, H:i') : '-' }}</li>
                {% if event.endDate %}
                <li class="mb-2"><i class="bi bi-calendar-check me-2 text-success"></i><strong>End:</strong> {{ event.endDate|date('d M Y, H:i') }}</li>
                {% endif %}
                {% if event.registrationDeadline %}
                <li class="mb-2"><i class="bi bi-clock me-2 text-warning"></i><strong>Deadline:</strong> {{ event.registrationDeadline|date('d M Y, H:i') }}</li>
                {% endif %}
                <li class="mb-2"><i class="bi bi-geo-alt me-2 text-success"></i>{{ event.location }}</li>
                <li class="mb-2"><i class="bi bi-person me-2 text-success"></i>Organized by <strong>{{ event.user.name }}</strong></li>
                <li class="mb-2"><i class="bi bi-people me-2 text-success"></i>{{ event.confirmedCount }} registered{% if event.capacity %} / {{ event.capacity }}{% endif %}</li>
                <li><i class="bi bi-calendar-plus me-2 text-success"></i>Created {{ event.createdAt ? event.createdAt|date('d M Y') : '-' }}</li>
            </ul>
        </div>

        <div class="d-flex gap-2 mb-3">
            <a href="{{ path('event_ical', {id: event.id}) }}" class="btn btn-outline-success btn-sm flex-fill">
                <i class="bi bi-calendar-plus me-1"></i>Add to Calendar
            </a>
            <a href="https://www.google.com/maps/search/?api=1&query={{ event.location|url_encode }}" target="_blank" class="btn btn-outline-secondary btn-sm flex-fill">
                <i class="bi bi-map me-1"></i>Maps
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3">
            <h6 class="fw-semibold mb-2"><i class="bi bi-ticket-perforated me-1"></i>Email Ticket and QR Code</h6>
            <div class="small text-muted">
                Event registration already sends a ticket by email. That ticket already includes a QR code, and the QR code opens the map search for this event location.
            </div>
            <div class="small text-muted mt-2">
                The QR code redirects the user to the map search for the event location.
            </div>
        </div>

        {% if event.latitude and event.longitude %}
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
            <iframe
                src="https://maps.google.com/maps?q={{ event.latitude }},{{ event.longitude }}&z=14&output=embed"
                width="100%" height="220" style="border:0" allowfullscreen loading="lazy"></iframe>
        </div>
        {% endif %}

        <div class="card border-0 shadow-sm rounded-4 p-3 event-chat-card">
            <div class="event-chat-header">
                <div class="event-chat-avatar">
                    <i class="bi bi-stars"></i>
                </div>
                <div>
                    <h6 class="fw-semibold mb-0">AgriBot Event Assistant</h6>
                    <div class="event-chat-subtitle">Type naturally. Your exact words are sent to AgriBot together with the event context.</div>
                </div>
            </div>
            <div class="event-chat-window mb-3">
                <div class="event-chat-bubble bot mb-2">
                    <span class="event-chat-label">AgriBot</span>
                    Ask naturally about the event. For example: "What should I bring?", "Is this good for beginners?", or "Would this suit someone interested in workshops?"
                </div>
                <div id="ai-user-preview" class="event-chat-bubble user d-none mb-2"></div>
                <div id="ai-answer" class="event-chat-bubble bot d-none"></div>
            </div>
            <textarea id="ai-question" class="form-control event-chat-input mb-2" placeholder="Example: I’m new to this kind of event, what should I expect?"></textarea>
            <button type="button" class="btn btn-outline-success btn-sm w-100" onclick="askAI(this)">
                <i class="bi bi-send me-1"></i>Send message
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function askAI(button) {
    var q = document.getElementById('ai-question').value.trim();
    if (!q) return;

    var btn = button || document.querySelector('[onclick="askAI(this)"]');
    var ansDiv = document.getElementById('ai-answer');
    var userDiv = document.getElementById('ai-user-preview');

    userDiv.classList.remove('d-none');
    userDiv.innerHTML = '<span class="event-chat-label">You</span>' + q.replace(/\n/g, '<br>');

    ansDiv.classList.remove('d-none');
    ansDiv.innerHTML = '<span class="event-chat-label">AgriBot</span><span class="event-chat-typing"><span></span><span></span><span></span></span>';
    btn.disabled = true;

    var exactQuestion = q.replace(/"/g, '\\"');
    var context = 'You are AgriBot, an event assistant for AgriCloud. Answer naturally, clearly, and helpfully. Keep the exact user wording in mind. Event context: title={{ event.title|e('js') }}, location={{ event.location|e('js') }}, date={{ event.eventDate ? event.eventDate|date('d M Y') : 'TBD' }}, category={{ event.category|e('js') }}. Exact user question: "' + exactQuestion + '".';

    fetch('{{ path('chatbot_message') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ message: context })
    })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            var reply = data.reply || 'I could not generate an answer right now.';
            ansDiv.innerHTML = '<span class="event-chat-label">AgriBot</span>' + reply.replace(/\n/g, '<br>');
        })
        .catch(function () {
            ansDiv.innerHTML = '<span class="event-chat-label">AgriBot</span>I could not reach AgriBot right now. Please try again.';
        })
        .finally(function () {
            btn.disabled = false;
        });
}

document.getElementById('ai-question').addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        askAI();
    }
});
</script>
{% endblock %}
